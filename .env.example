# Cloudflare R2 — create a private bucket and an API token with Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Set this only after configuring authentication and upload authorization.
# Do not expose storage credentials in NEXT_PUBLIC_* variables.
# Vercel AI Gateway — Vercel OIDC is automatic after deployment; use a key for local/non-Vercel runs.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=google/gemini-3.1-flash-lite

# Protects the internal transcript-analysis endpoint until user authentication is implemented.
VIRALCUT_INTERNAL_API_KEY=

# Server-to-server key for requesting short-lived R2 upload URLs. Never expose in browser code.
VIRALCUT_UPLOAD_API_KEY=
