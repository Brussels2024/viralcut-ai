# Copy to .env.live on the persistent worker host. Never commit .env.live.
LIVE_INPUT_URL=rtmp://YOUR_INGEST_HOST/YOUR_STREAM_KEY
SESSION_ID=live-session-001
VIRALCUT_WINDOW_SECONDS=600

# Public base URL of the ViralCut web app, without a trailing slash.
VIRALCUT_API_BASE_URL=https://YOUR-VIRALCUT-DOMAIN
VIRALCUT_INTERNAL_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
OPENAI_API_KEY=REPLACE_WITH_A_SEPARATE_OPENAI_API_KEY
VIRALCUT_TRANSCRIPTION_MODEL=whisper-1
VIRALCUT_PROCESS_POLL_MS=5000
